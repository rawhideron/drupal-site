# Copy this file to .env and fill in real values before running docker-compose up.
# .env is gitignored — never commit real secrets.

WEB_PORT=8080

DB_ROOT_PASSWORD=changeme-root
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=changeme

# Generate with: openssl rand -hex 32
HASH_SALT=changeme-generate-a-random-64-char-string

# Nginx Proxy Manager drops from root to this uid/gid after startup.
# Defaults to 1000; set to your host user's `id -u` / `id -g` if different.
#NPM_PUID=1000
#NPM_PGID=1000
