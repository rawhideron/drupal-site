# Environment / secrets
.env

# Everything under web/ is Composer-managed (drupal/core-recommended) or
# generated by Drupal itself (settings.php, files/, scaffold files like
# index.php/.htaccess/default.settings.php). Only files we actually wrote
# ourselves are tracked. When custom modules/themes are added later
# (web/modules/custom, web/themes/custom, ...), add "!/web/modules/",
# "!/web/modules/custom/", etc. here.
/vendor/
/web/*
!/web/sites/
/web/sites/*
!/web/sites/sites.php

composer.phar
*.log
.DS_Store
